{
  "name": "jingheng-scoreboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "concurrently -k \"node --env-file-if-exists=.env --watch server/index.js\" \"vite --host 0.0.0.0\"",
    "build": "node scripts/build.mjs",
    "start": "node --env-file-if-exists=.env server/index.js",
    "demo": "node --env-file-if-exists=.env scripts/seed.mjs",
    "simulate": "node --env-file-if-exists=.env scripts/simulate-judges.mjs",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "backup": "node --env-file-if-exists=.env scripts/backup.mjs"
  },
  "dependencies": {
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "modern-screenshot": "^4.7.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@playwright/test": "^1.56.0",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.0",
    "vite": "^7.2.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
